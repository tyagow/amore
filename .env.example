# Database
DATABASE_URL=postgresql://amore-couples:amore_dev_password@localhost:5440/amore_couples

# Auth
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:9941
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI
ANTHROPIC_API_KEY=

# Redis
REDIS_URL=redis://localhost:6381

# WA Bridge
WA_BRIDGE_URL=http://localhost:9945
WA_BRIDGE_JWT_SECRET=replace-with-shared-jwt-secret
WA_BRIDGE_PORT=9945

# Web app
WEB_APP_URL=http://localhost:9941

# Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
VITE_VAPID_PUBLIC_KEY=

# Stripe (future)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# VITE_STRIPE_PUBLIC_KEY=

# Production backup (for scripts/backup-prod-db.sh)
# PROD_DATABASE_URL=postgresql://postgres:...@host:port/railway

# Migration workflow:
# 1. Edit packages/db/src/schema.ts
# 2. Generate migration: cd packages/db && npx drizzle-kit generate
# 3. Review generated SQL in packages/db/drizzle/
# 4. Migrations auto-apply on deploy via runMigrations() in start.mjs
# Do NOT use `drizzle-kit push` — it bypasses the migration journal
